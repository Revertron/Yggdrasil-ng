from typing import Callable, Optional, Tuple

UDP_HEADER_LEN: int
__version__: str

def generate_config() -> str: ...
def set_logger(callback: Callable[[int, str], None], filter: str = "info") -> None: ...

class NativeNode:
    def __init__(self, config_toml: Optional[str] = None, admin: bool = False) -> None: ...
    def address(self) -> str: ...
    def subnet(self) -> str: ...
    def public_key(self) -> str: ...
    def add_peer(self, uri: str) -> None: ...
    def remove_peer(self, uri: str) -> None: ...
    def admin(self, request_json: str) -> str: ...
    def resolve(self, host: str) -> str: ...
    def ping(self, host: str, timeout: Optional[float] = None) -> float: ...
    def tcp_connect(self, host: str, port: int, timeout: Optional[float] = None) -> int: ...
    def tcp_listen(self, port: int) -> int: ...
    def tcp_accept(self, listener: int, timeout: Optional[float] = None) -> Tuple[int, str]: ...
    def tcp_listener_close(self, listener: int) -> None: ...
    def udp_bind(self, port: int = 0) -> Tuple[int, int]: ...
    def udp_close(self, sock: int) -> None: ...
    def socks5_start(self, listen: str, username: Optional[str] = None, password: Optional[str] = None) -> int: ...
    def forward_local_tcp(self, listen: str, target: str) -> int: ...
    def forward_local_udp(self, listen: str, target: str) -> int: ...
    def forward_remote_tcp(self, port: int, target: str) -> int: ...
    def forward_remote_udp(self, port: int, target: str) -> int: ...
    def service_stop(self, id: int) -> None: ...
    def closed(self) -> bool: ...
    def close(self) -> None: ...
